--- /dev/null
+++ b/custom_components/climate_advisor/adaptive_mode_preview.py
@@ -0,0 +1,435 @@
+# SPDX-License-Identifier: MIT
+"""Disconnected, single-zone mode decisions; never a thermostat dispatcher.
+
+Snapshots/revisions are caller-supplied evidence, not an HA ownership detector.
+Requests select an evaluator, not a target. No existing engine imports this model.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field, replace
+from typing import Literal, TypeGuard
+
+ADAPTIVE_POLICY = "adaptive_comfort"
+Hold = Literal["none", "manual", "reconcile"]
+Handback = Literal["none", "pending", "unknown"]
+RequestKind = Literal["ordinary", "adaptive", "handback"]
+_EVENTS = (
+    "refresh",
+    "enable",
+    "disable",
+    "manual_change",
+    "resume",
+    "restart",
+    "handback_confirmed",
+    "handback_failed",
+    "retry_handback",
+)
+
+
+@dataclass(frozen=True)
+class HostPolicy:
+    """Current ordinary policy reference and retained host permissions."""
+
+    policy_id: str
+    owner_revision: int
+    settings_revision: int
+    automation_enabled: bool = False
+    observe_only: bool = True
+    external_hold: bool = False
+
+
+@dataclass(frozen=True)
+class ModeInputs:
+    """Explicit fake-host evidence; ready does not implement safety checks."""
+
+    host: HostPolicy
+    routine_revision: int = 0
+    approved: bool = False
+    ready: bool = False
+
+
+@dataclass(frozen=True)
+class ModeRequest:
+    """Request fresh policy evaluation, never restoration of a stored target."""
+
+    kind: RequestKind
+    policy_id: str
+    session_id: str
+    generation: int
+    inputs: ModeInputs
+    commands_allowed: Literal[False] = field(default=False, init=False)
+
+
+@dataclass(frozen=True)
+class ModeState:
+    """Caller retains each returned state; use a fresh session ID after reconstruction."""
+
+    session_id: str
+    generation: int = 0
+    selected: bool = False
+    previous: HostPolicy | None = None
+    routine_revision: int | None = None
+    hold: Hold = "none"
+    handback: Handback = "none"
+    pending_request: ModeRequest | None = None
+
+
+@dataclass(frozen=True)
+class ModeEvent:
+    """An explicit event from this session/generation, not an automatic callback."""
+
+    kind: str
+    session_id: str
+    generation: int
+    reconciled: bool = False
+    request: ModeRequest | None = None
+
+
+@dataclass(frozen=True)
+class ModeDecision:
+    """A next state and explained selection/withholding, with no command permission."""
+
+    state: ModeState
+    reason_code: str
+    explanation: str
+    request: ModeRequest | None = None
+    commands_allowed: Literal[False] = field(default=False, init=False)
+
+
+def _identity(value: object) -> bool:
+    return isinstance(value, str) and bool(value.strip())
+
+
+def _revision(value: object) -> bool:
+    return type(value) is int and value >= 0
+
+
+def _valid_host(host: object) -> TypeGuard[HostPolicy]:
+    return (
+        isinstance(host, HostPolicy)
+        and _identity(host.policy_id)
+        and host.policy_id != ADAPTIVE_POLICY
+        and _revision(host.owner_revision)
+        and _revision(host.settings_revision)
+        and all(type(flag) is bool for flag in (host.automation_enabled, host.observe_only, host.external_hold))
+    )
+
+
+def _valid_inputs(inputs: object) -> TypeGuard[ModeInputs]:
+    return (
+        isinstance(inputs, ModeInputs)
+        and _valid_host(inputs.host)
+        and _revision(inputs.routine_revision)
+        and type(inputs.approved) is bool
+        and type(inputs.ready) is bool
+    )
+
+
+def _valid_request(request: object) -> TypeGuard[ModeRequest]:
+    return (
+        isinstance(request, ModeRequest)
+        and request.kind in ("ordinary", "adaptive", "handback")
+        and _identity(request.policy_id)
+        and _identity(request.session_id)
+        and _revision(request.generation)
+        and _valid_inputs(request.inputs)
+        and request.commands_allowed is False
+    )
+
+
+def _same_owner(previous: HostPolicy | None, host: HostPolicy) -> bool:
+    return previous is not None and (previous.policy_id, previous.owner_revision) == (
+        host.policy_id,
+        host.owner_revision,
+    )
+
+
+def _valid_state(state: object) -> TypeGuard[ModeState]:
+    if not (
+        isinstance(state, ModeState)
+        and _identity(state.session_id)
+        and _revision(state.generation)
+        and type(state.selected) is bool
+        and state.hold in ("none", "manual", "reconcile")
+        and state.handback in ("none", "pending", "unknown")
+    ):
+        return False
+    if state.handback != "none" and state.hold == "manual":
+        return False
+    if state.selected:
+        if state.handback != "none" or not _revision(state.routine_revision):
+            return False
+    elif state.routine_revision is not None:
+        return False
+    if state.selected or state.handback != "none":
+        if not _valid_host(state.previous):
+            return False
+    elif state.previous is not None:
+        return False
+    if state.handback == "pending":
+        request = state.pending_request
+        return (
+            state.hold == "none"
+            and _valid_request(request)
+            and request.kind == "handback"
+            and (request.session_id, request.generation) == (state.session_id, state.generation)
+            and request.policy_id == request.inputs.host.policy_id
+            and _same_owner(state.previous, request.inputs.host)
+        )
+    return state.pending_request is None
+
+
+def _valid_event(event: object) -> TypeGuard[ModeEvent]:
+    return (
+        isinstance(event, ModeEvent)
+        and isinstance(event.kind, str)
+        and event.kind in _EVENTS
+        and _identity(event.session_id)
+        and _revision(event.generation)
+        and type(event.reconciled) is bool
+        and (event.request is None or _valid_request(event.request))
+    )
+
+
+def _held(state: ModeState, hold: Hold, *, force: bool = False) -> ModeState:
+    hold = "manual" if state.hold == "manual" else hold
+    handback: Handback = "unknown" if state.handback != "none" and hold != "manual" else "none"
+    updated = replace(
+        state,
+        hold=hold,
+        handback=handback,
+        previous=state.previous if state.selected or handback != "none" else None,
+        pending_request=None,
+    )
+    return replace(updated, generation=state.generation + 1) if force or updated != state else state
+
+
+def _ordinary_only(state: ModeState) -> bool:
+    return not state.selected and state.hold == "none" and state.handback == "none"
+
+
+def _disable_held(state: ModeState) -> ModeState:
+    if not state.selected:
+        return state
+    handback: Handback = "none" if state.hold == "manual" else "unknown"
+    return replace(
+        state,
+        generation=state.generation + 1,
+        selected=False,
+        routine_revision=None,
+        previous=state.previous if handback == "unknown" else None,
+        handback=handback,
+        pending_request=None,
+    )
+
+
+def _guard(state: ModeState, inputs: ModeInputs) -> ModeState:
+    # An unused overlay must not replace the ordinary host's hold policy.
+    if _ordinary_only(state):
+        return state
+    if inputs.host.external_hold or (state.previous is not None and not _same_owner(state.previous, inputs.host)):
+        return _held(state, "manual")
+    if state.selected and (
+        not inputs.approved or not inputs.ready or state.routine_revision != inputs.routine_revision
+    ):
+        return _held(state, "reconcile")
+    if state.handback == "pending" and (
+        not inputs.ready or state.pending_request is None or state.pending_request.inputs != inputs
+    ):
+        return _held(state, "reconcile")
+    return state
+
+
+def request_is_current(request: object, state: object, inputs: object) -> bool:
+    """Reject stale selector work; not an authorization or atomic dispatch check."""
+    if not (_valid_request(request) and _valid_state(state) and _valid_inputs(inputs)):
+        return False
+    if (request.session_id, request.generation, request.inputs) != (state.session_id, state.generation, inputs):
+        return False
+    if state.hold != "none" or (inputs.host.external_hold and not _ordinary_only(state)):
+        return False
+    if state.selected:
+        return (
+            request.kind == "adaptive"
+            and request.policy_id == ADAPTIVE_POLICY
+            and inputs.approved
+            and inputs.ready
+            and inputs.routine_revision == state.routine_revision
+            and _same_owner(state.previous, inputs.host)
+        )
+    if state.handback == "pending":
+        return (
+            request == state.pending_request
+            and inputs.ready
+            and request.kind == "handback"
+            and request.policy_id == inputs.host.policy_id
+            and _same_owner(state.previous, inputs.host)
+        )
+    return state.handback == "none" and request.kind == "ordinary" and request.policy_id == inputs.host.policy_id
+
+
+def _selection(state: ModeState, inputs: ModeInputs, reason: str) -> ModeDecision:
+    if state.hold == "manual":
+        return ModeDecision(
+            state, "manual_hold", "A manual/external hold needs explicit reconciled resume; no evaluation."
+        )
+    if state.handback != "none":
+        return ModeDecision(state, f"handback_{state.handback}", "Logical hand-back is unresolved; no automatic retry.")
+    if state.hold == "reconcile":
+        return ModeDecision(
+            state, "reconciliation_required", "Current evidence must be reconciled and explicitly resumed."
+        )
+    kind: RequestKind = "adaptive" if state.selected else "ordinary"
+    policy_id = ADAPTIVE_POLICY if state.selected else inputs.host.policy_id
+    request = ModeRequest(kind, policy_id, state.session_id, state.generation, inputs)
+    return ModeDecision(
+        state, reason, "Evaluate the selected policy afresh; no target or command is restored.", request
+    )
+
+
+def _begin_handback(state: ModeState, inputs: ModeInputs) -> ModeDecision:
+    state = replace(
+        state,
+        generation=state.generation + 1,
+        selected=False,
+        routine_revision=None,
+        hold="none",
+        handback="pending",
+        pending_request=None,
+    )
+    request = ModeRequest("handback", inputs.host.policy_id, state.session_id, state.generation, inputs)
+    state = replace(state, pending_request=request)
+    return ModeDecision(
+        state,
+        "handback_requested",
+        "Adaptive selection ended; current ordinary-policy evaluation is pending, not restored.",
+        request,
+    )
+
+
+def decide_mode(state: ModeState, inputs: ModeInputs, event: ModeEvent) -> ModeDecision:
+    """Apply one synthetic event without changing host settings or executing policy.
+
+    Invalid internal state is a caller error, never an implicit reset. Live inputs
+    fail closed into reconciliation. Sessions/revisions must be maintained by the
+    caller; this module cannot observe equipment, correlate HA writes or persist.
+    """
+    if not _valid_state(state):
+        raise ValueError("Invalid mode state; reconstruct explicitly with a fresh session ID, never a guessed reset.")
+    if not _valid_event(event):
+        return ModeDecision(state, "invalid_event", "Supply a valid explicit mode event; no event was executed.")
+    if (event.session_id, event.generation) != (state.session_id, state.generation):
+        return ModeDecision(state, "stale_event", "The event belongs to an obsolete session or generation.")
+    if not _valid_inputs(inputs):
+        if _ordinary_only(state):
+            state = replace(state, generation=state.generation + 1)
+        else:
+            state = _held(state, "manual" if event.kind == "manual_change" else "reconcile", force=True)
+            if event.kind == "disable":
+                state = _disable_held(state)
+        return ModeDecision(
+            state, "invalid_inputs", "Invalid current evidence; work invalidated with no fallback request."
+        )
+
+    state = _guard(state, inputs)
+    if _ordinary_only(state) and event.kind in ("manual_change", "restart", "resume"):
+        state = replace(state, generation=state.generation + 1)
+        return ModeDecision(
+            state, "ordinary_unchanged", "Adaptive mode owns no policy or hold; ordinary behavior is retained."
+        )
+    if event.kind == "manual_change":
+        return ModeDecision(
+            _held(state, "manual", force=True), "manual_hold", "Newer manual authority takes precedence."
+        )
+    if event.kind == "restart":
+        return ModeDecision(
+            _held(state, "reconcile", force=True),
+            "restart_requires_reconciliation",
+            "Outstanding work invalidated; restart cannot automatically resume a policy or complete hand-back.",
+        )
+    if event.kind == "refresh":
+        return _selection(state, inputs, "adaptive_selected" if state.selected else "ordinary_selected")
+
+    if event.kind in ("handback_confirmed", "handback_failed"):
+        if state.handback != "pending" or not request_is_current(event.request, state, inputs):
+            return ModeDecision(
+                state, "stale_handback", "Only the matching current pending request can report an outcome."
+            )
+        if event.kind == "handback_failed":
+            state = replace(state, generation=state.generation + 1, handback="unknown", pending_request=None)
+            return ModeDecision(state, "handback_failed", "Logical hand-back outcome is unknown; no automatic retry.")
+        state = replace(state, generation=state.generation + 1, handback="none", previous=None, pending_request=None)
+        return ModeDecision(
+            state, "handback_confirmed", "Logical hand-back confirmed by the caller; not proof of physical release."
+        )
+
+    if event.kind == "retry_handback":
+        if state.handback != "unknown":
+            return ModeDecision(state, "no_handback_to_retry", "There is no unknown, still-owned hand-back to retry.")
+        if not event.reconciled:
+            return ModeDecision(
+                state, "retry_requires_reconciliation", "Retry requires explicit current-state reconciliation."
+            )
+        if not inputs.ready:
+            return ModeDecision(
+                _held(state, "reconcile"), "not_ready", "Required current inputs are not ready for hand-back."
+            )
+        return _begin_handback(state, inputs)
+
+    if event.kind == "disable":
+        if not state.selected:
+            return ModeDecision(
+                state, "already_disabled", "Adaptive selection is already off; no duplicate return request."
+            )
+        if state.hold != "none":
+            state = _disable_held(state)
+            return ModeDecision(
+                state,
+                "disabled_preserving_hold",
+                "Adaptive selection ended without overwriting newer or unknown authority.",
+            )
+        return _begin_handback(state, inputs)
+
+    if state.handback != "none":
+        return _selection(state, inputs, "blocked")
+    if event.kind == "resume":
+        if not event.reconciled:
+            return ModeDecision(
+                state, "resume_requires_reconciliation", "Resume requires explicit current-state reconciliation."
+            )
+        if inputs.host.external_hold:
+            return _selection(state, inputs, "blocked")
+        if not inputs.ready or (state.selected and not inputs.approved):
+            return ModeDecision(
+                state, "not_ready", "Resume needs valid current inputs and approval for adaptive selection."
+            )
+        state = replace(
+            state,
+            generation=state.generation + 1,
+            hold="none",
+            previous=inputs.host if state.selected else None,
+            routine_revision=inputs.routine_revision if state.selected else None,
+        )
+        return _selection(state, inputs, "resumed")
+
+    if state.hold != "none":
+        return _selection(state, inputs, "blocked")
+    if inputs.host.external_hold:
+        return ModeDecision(
+            state, "manual_hold", "An existing host hold blocks adaptive enable; ordinary behavior is retained."
+        )
+    if not inputs.approved:
+        return ModeDecision(state, "unapproved", "Enabling the feature cannot approve a routine.")
+    if not inputs.ready:
+        return ModeDecision(state, "not_ready", "Required inputs are not ready; adaptive selection was not enabled.")
+    if state.selected:
+        return _selection(state, inputs, "already_selected")
+    state = replace(
+        state,
+        generation=state.generation + 1,
+        selected=True,
+        previous=inputs.host,
+        routine_revision=inputs.routine_revision,
+    )
+    return _selection(state, inputs, "adaptive_selected")
