+# SPDX-License-Identifier: MIT
+"""Synthetic ownership/selection tests, not Climate Advisor callback or HVAC tests."""
+
+from __future__ import annotations
+
+import ast
+from dataclasses import FrozenInstanceError, replace
+from datetime import UTC, datetime
+from itertools import product
+from pathlib import Path
+
+import pytest
+
+from custom_components.climate_advisor import adaptive_mode_preview
+from custom_components.climate_advisor.adaptive_mode_preview import (
+    ADAPTIVE_POLICY,
+    HostPolicy,
+    ModeDecision,
+    ModeEvent,
+    ModeInputs,
+    ModeRequest,
+    ModeState,
+    decide_mode,
+    request_is_current,
+)
+
+
+def inputs(**changes):
+    return replace(
+        ModeInputs(
+            host=HostPolicy("schedule", owner_revision=1, settings_revision=1),
+            routine_revision=1,
+            approved=True,
+            ready=True,
+        ),
+        **changes,
+    )
+
+
+def host_changed(data, **changes):
+    return replace(data, host=replace(data.host, **changes))
+
+
+def send(state, kind, data, **changes):
+    event = ModeEvent(kind, state.session_id, state.generation, **changes)
+    return decide_mode(state, data, event)
+
+
+def enabled(data=None):
+    return send(ModeState("session-1"), "enable", inputs() if data is None else data)
+
+
+def pending(data=None):
+    data = inputs() if data is None else data
+    return send(enabled(data).state, "disable", data)
+
+
+class FakePolicies:
+    """Independent arithmetic evaluators; neither one implements mode selection."""
+
+    def __init__(self):
+        self.calls = []
+        self.evaluators = {"schedule": self.ordinary, "holiday": self.ordinary, ADAPTIVE_POLICY: self.adaptive}
+
+    @staticmethod
+    def ordinary(now, data):
+        floor = (68 if now.hour < 12 else 74) + data.host.settings_revision
+        return floor, floor + 6
+
+    @staticmethod
+    def adaptive(now, data):
+        return 64, 70
+
+    def consume(self, request, state, data, *, now):
+        if not request_is_current(request, state, data):
+            return None
+        self.calls.append(request.policy_id)
+        return self.evaluators[request.policy_id](now, data)
+
+
+def test_m01_never_selected_delegates_to_unchanged_ordinary_policy():
+    data = inputs(approved=False, ready=False)
+    state = ModeState("session-1")
+    result = send(state, "refresh", data)
+    now = datetime(2026, 1, 2, 9, tzinfo=UTC)
+    fake = FakePolicies()
+    assert result.state == state
+    assert result.request.kind == "ordinary"
+    assert fake.consume(result.request, state, data, now=now) == fake.ordinary(now, data)
+    assert result.commands_allowed is False
+
+
+def test_m02_enable_is_explicit_idempotent_and_does_not_mutate_settings():
+    data = inputs()
+    before = repr(data)
+    first = enabled(data)
+    second = send(first.state, "enable", data)
+    assert first.state.selected is True
