+    path = Path(sleep_timing.__file__)
+    tree = ast.parse(path.read_text(encoding="utf-8"))
+    allowed = {"__future__", "dataclasses", "datetime", "itertools", "typing", "zoneinfo"}
+    for node in ast.walk(tree):
+        if isinstance(node, ast.ImportFrom):
+            assert not node.level and node.module in allowed
+        elif isinstance(node, ast.Import):
+            assert all(alias.name in allowed for alias in node.names)
+        elif isinstance(node, ast.Attribute):
+            assert node.attr not in {"now", "today", "utcnow"}
+    for other in path.parent.glob("*.py"):
+        if other != path:
+            assert "sleep_timing" not in other.read_text(encoding="utf-8"), other.name
