+        anchors=tuple(replace(a, floor_f=f, ceiling_f=c) for a, (f, c) in zip(config.anchors, bands, strict=True)),
+    )
+    result = preview_trajectory(config, now=START + timedelta(hours=1))
+    assert result.status == "preview"
+    assert result.floor_f == 0
+    assert result.ceiling_f == 1e307
+
+
+def test_float_output_cannot_collapse_an_approved_narrow_band():
+    config = routine()
+    high = (70, 70.00000000000001)
+    low = (69.99999999999999, 70)
+    config = replace(
+        config,
+        limits=TrajectoryLimits(69, 71, 1e-14, 1),
+        anchors=tuple(
+            replace(a, floor_f=f, ceiling_f=c)
+            for a, (f, c) in zip(config.anchors, (high, low, low, high, high), strict=True)
+        ),
+    )
+    assert_withheld(preview_trajectory(config, now=START + timedelta(hours=1)), "unrepresentable_preview")
+
+
+def test_inputs_and_results_are_immutable_and_never_grant_control():
+    config = routine()
+    result = preview_trajectory(config, now=START)
+    for obj, field, value in [(config, "enabled", False), (config.anchors[0], "floor_f", 99), (result, "floor_f", 99)]:
+        with pytest.raises(FrozenInstanceError):
+            setattr(obj, field, value)
+    with pytest.raises(TypeError):
+        TrajectoryPreview(status="preview", reason_code="ready", explanation="test", commands_allowed=True)
+
+
+def test_calculator_has_no_policy_io_or_live_planner_imports():
+    path = Path(sleep_trajectory.__file__)
+    tree = ast.parse(path.read_text(encoding="utf-8"))
+    allowed = {"__future__", "dataclasses", "datetime", "fractions", "itertools", "math", "typing"}
+    for node in ast.walk(tree):
+        if isinstance(node, ast.ImportFrom):
+            assert not node.level
+            assert node.module in allowed
+        elif isinstance(node, ast.Import):
+            assert all(alias.name in allowed for alias in node.names)
+    for other in path.parent.glob("*.py"):
+        if other == path:
+            continue
+        assert "sleep_trajectory" not in other.read_text(encoding="utf-8"), other.name
