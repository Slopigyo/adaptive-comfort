+# SPDX-License-Identifier: MIT
+"""Dated local-time resolution, not a scheduler or a hardware-control test."""
+
+from __future__ import annotations
+
+import ast
+from dataclasses import FrozenInstanceError, replace
+from datetime import UTC, date, datetime, time, timedelta
+from pathlib import Path
+from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
+
+import pytest
+
+from custom_components.climate_advisor import sleep_timing
+from custom_components.climate_advisor.sleep_timing import LocalSleepTiming, resolve_sleep_timing
+from custom_components.climate_advisor.sleep_trajectory import (
+    SleepTrajectory,
+    TrajectoryAnchor,
+    TrajectoryLimits,
+    preview_trajectory,
+)
+
+WAKE_DATE = date(2026, 1, 2)
+
+
+def timing(**changes):
+    return replace(
+        LocalSleepTiming(
+            timezone_key="UTC",
+            wind_down_start=time(22),
+            wind_down_day_offset=-1,
+            sleep_start=time(0),
+            sleep_day_offset=0,
+            wake_time=time(7),
+            warming_duration=timedelta(hours=2),
+            return_duration=timedelta(hours=2),
+        ),
+        **changes,
+    )
+
+
+def trajectory(result, **flags):
+    assert result.status == "resolved"
+    bands = ((68, 74), (64, 70), (64, 70), (69, 75), (68, 74))
+    config = SleepTrajectory(
+        enabled=True,
+        approved=True,
+        limits=TrajectoryLimits(60, 80, 4, 2.5),
+        anchors=tuple(
+            TrajectoryAnchor(anchor.at, floor, ceiling, anchor.phase)
+            for anchor, (floor, ceiling) in zip(result.anchors, bands, strict=True)
+        ),
+    )
+    return replace(config, **flags)
+
+
+def assert_withheld(result, reason):
+    assert result.status == "withheld"
+    assert result.reason_code == reason
+    assert result.anchors == ()
+    assert result.adjustments == ()
+    assert result.commands_allowed is False
+    assert result.explanation
+
+
+def test_utc_night_matches_existing_arithmetic_fixture():
+    result = resolve_sleep_timing(timing(), wake_date=WAKE_DATE)
+    assert result.status == "resolved"
+    assert result.reason_code == "ready"
+    assert result.commands_allowed is False
+    assert result.adjustments == ()
