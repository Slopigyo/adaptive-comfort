@@ -0,0 +1,157 @@
+# SPDX-License-Identifier: MIT
+"""Resolve one local wake date for a disconnected preview, never run a schedule.
+
+ZoneInfo reads locally installed IANA data; there is no network/database download,
+HA access, host-clock read, temperature policy, persistence, or command path.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from datetime import UTC, date, datetime, time, timedelta
+from itertools import pairwise
+from typing import Literal
+from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
+
+
+@dataclass(frozen=True)
+class LocalSleepTiming:
+    """Explicit wall times and elapsed ramps for a caller-supplied wake date.
+
+    Wind-down and sleep may begin on that date (offset 0) or the preceding date
+    (offset -1). Wake time belongs to the supplied date. There are no defaults.
+    """
+
+    timezone_key: str
+    wind_down_start: time
+    wind_down_day_offset: int
+    sleep_start: time
+    sleep_day_offset: int
+    wake_time: time
+    warming_duration: timedelta
+    return_duration: timedelta
+
+
+@dataclass(frozen=True)
+class TimingAnchor:
+    """An ordered UTC phase boundary, without a temperature or approval flag."""
+
+    at: datetime
+    phase: str
+
+
+@dataclass(frozen=True)
+class SleepTimingResolution:
+    """Dated timing or an explanation; never a partially resolved routine."""
+
+    status: Literal["resolved", "withheld"]
+    reason_code: str
+    explanation: str
+    anchors: tuple[TimingAnchor, ...] = ()
+    adjustments: tuple[str, ...] = ()
+    commands_allowed: Literal[False] = field(default=False, init=False)
+
+
+class _InvalidTiming(ValueError):
+    def __init__(self, reason_code: str, message: str) -> None:
+        super().__init__(message)
+        self.reason_code = reason_code
+
+
+def _resolve_wall(wall: datetime, zone: ZoneInfo, label: str) -> tuple[datetime, str | None]:
+    # Attaching tzinfo alone accepts nonexistent times. Round-trip both folds
+    # through UTC to distinguish ordinary, repeated and missing wall times.
+    candidates = {wall.replace(tzinfo=zone, fold=fold).astimezone(UTC) for fold in (0, 1)}
+    round_trips = [(instant, instant.astimezone(zone).replace(tzinfo=None)) for instant in candidates]
+    valid = sorted(instant for instant, local in round_trips if local == wall)
+    if valid:
+        adjustment = None
+        if len(valid) > 1:
+            adjustment = f"{label}: DST fold at {wall.isoformat()}; chose earlier occurrence {valid[0].isoformat()}."
+        return valid[0], adjustment
+
+    forward = sorted((local, instant) for instant, local in round_trips if local > wall)
+    if not forward:
+        raise _InvalidTiming("invalid_time", f"{label}: local time cannot be resolved by the gap-forward policy.")
+    shifted, instant = forward[0]
+    if shifted.date() != wall.date():
+        raise _InvalidTiming("date_shift", f"{label}: gap resolution would change the requested calendar date.")
+    return instant, f"{label}: DST gap moved {wall.isoformat()} forward to {shifted.isoformat()} in {zone.key}."
+
+
+def resolve_sleep_timing(config: LocalSleepTiming, *, wake_date: date) -> SleepTimingResolution:
+    """Resolve fixed-wake timing using local IANA rules and exact elapsed ramps.
+
+    Gaps move forward by the actual offset gap; folds use the earlier UTC instant.
+    Calendar-date changes caused by a gap are withheld rather than moving a night
+    to another wake date. All five UTC instants must be strictly increasing.
+
+    This does not enable/approve a routine or validate its bands/rates. Callers
+    must still pass dated anchors through the trajectory evaluator. Repeating
+    dates, adjacent-routine overlap, lifecycle invalidation and control are not
+    implemented here.
+    """
+    try:
+        if not isinstance(config, LocalSleepTiming):
+            raise _InvalidTiming("invalid_configuration", "Supply an explicit LocalSleepTiming configuration.")
+        if type(wake_date) is not date:
+            raise _InvalidTiming("invalid_date", "Supply a wake date, not a datetime, string or host-clock default.")
+        for offset in (config.wind_down_day_offset, config.sleep_day_offset):
+            if type(offset) is not int or offset not in (-1, 0):
+                raise _InvalidTiming("invalid_offset", "Wind-down/sleep day offsets must be integers -1 or 0.")
+        for wall_time in (config.wind_down_start, config.sleep_start, config.wake_time):
+            if not isinstance(wall_time, time) or wall_time.tzinfo is not None or wall_time.fold != 0:
+                raise _InvalidTiming(
+                    "invalid_time", "Supply naive wall times with fold=0; the resolver owns DST policy."
+                )
+        for duration in (config.warming_duration, config.return_duration):
+            if not isinstance(duration, timedelta) or duration <= timedelta(0):
+                raise _InvalidTiming("invalid_duration", "Warming and return durations must be positive timedeltas.")
+        if not isinstance(config.timezone_key, str) or not config.timezone_key:
+            raise _InvalidTiming("invalid_timezone", "Supply an explicit IANA timezone key.")
+        try:
+            zone = ZoneInfo(config.timezone_key)
+        except (ZoneInfoNotFoundError, ValueError, OSError) as error:
+            raise _InvalidTiming(
+                "invalid_timezone",
+                "IANA timezone or local timezone data is unavailable; no zone was guessed or downloaded.",
+            ) from error
+
+        wall_specs = (
+            ("wind_down", config.wind_down_day_offset, config.wind_down_start),
+            ("sleeping", config.sleep_day_offset, config.sleep_start),
+            ("wake", 0, config.wake_time),
+        )
+        resolved: list[datetime] = []
+        adjustments: list[str] = []
+        for label, offset, wall_time in wall_specs:
+            wall = datetime.combine(wake_date + timedelta(days=offset), wall_time)
+            instant, adjustment = _resolve_wall(wall, zone, label)
+            resolved.append(instant)
+            if adjustment:
+                adjustments.append(adjustment)
+        wind_down, sleeping, wake = resolved
+        anchors = (
+            TimingAnchor(wind_down, "wind_down"),
+            TimingAnchor(sleeping, "sleeping"),
+            TimingAnchor(wake - config.warming_duration, "waking"),
+            TimingAnchor(wake, "return_to_day"),
+            TimingAnchor(wake + config.return_duration, "daytime"),
+        )
+        if any(left.at >= right.at for left, right in pairwise(anchors)):
+            raise _InvalidTiming(
+                "invalid_order", "Resolved phases overlap or have zero duration; no times were reordered."
+            )
+        return SleepTimingResolution(
+            "resolved",
+            "ready",
+            "Resolved one fixed-wake routine in UTC; bands, approval and elapsed rates still require validation.",
+            anchors,
+            tuple(adjustments),
+        )
+    except _InvalidTiming as error:
+        return SleepTimingResolution("withheld", error.reason_code, str(error))
+    except (OverflowError, ValueError) as error:
+        return SleepTimingResolution(
+            "withheld", "invalid_time", f"Resolved times or durations exceed datetime's range: {error}."
+        )
