+            TrajectoryAnchor(start + timedelta(hours=7), 64, 70, "waking"),
+            TrajectoryAnchor(start + timedelta(hours=9), 69, 75, "return_to_day"),
+            TrajectoryAnchor(start + timedelta(hours=11), 68, 74, "daytime"),
+        ),
+    )
