@@ -0,0 +1,223 @@
+# SPDX-License-Identifier: MIT
+"""Disconnected sleep/wake band preview; no planner, HA, clock, or actuator access.
+
+Inputs describe one already-resolved night, not a recurring local-time schedule.
+All temperatures and rates use internal Fahrenheit. Returned floats are preview
+values, not quantized device targets or permission to choose an HVAC mode.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from datetime import UTC, datetime, timedelta
+from fractions import Fraction
+from itertools import pairwise
+from math import isfinite
+from typing import Literal
+
+_PHASES = ("wind_down", "sleeping", "waking", "return_to_day", "daytime")
+_MICROSECOND = timedelta(microseconds=1)
+_HOUR_MICROSECONDS = 3_600_000_000
+
+
+@dataclass(frozen=True)
+class TrajectoryAnchor:
+    """The band and phase beginning at an explicitly supplied aware instant."""
+
+    at: datetime
+    floor_f: float
+    ceiling_f: float
+    phase: str
+
+
+@dataclass(frozen=True)
+class TrajectoryLimits:
+    """Caller-approved arithmetic constraints, with no household defaults."""
+
+    minimum_f: float
+    maximum_f: float
+    minimum_width_f: float
+    maximum_rate_f_per_hour: float
+
+
+@dataclass(frozen=True)
+class SleepTrajectory:
+    """Five ordered anchors; merely enabling a routine does not approve it."""
+
+    anchors: tuple[TrajectoryAnchor, ...] = ()
+    limits: TrajectoryLimits | None = None
+    enabled: bool = False
+    approved: bool = False
+
+
+@dataclass(frozen=True)
+class TrajectoryPreview:
+    """A preview or an explained absence of one, never a control decision."""
+
+    status: Literal["disabled", "withheld", "preview"]
+    reason_code: str
+    explanation: str
+    floor_f: float | None = None
+    ceiling_f: float | None = None
+    phase: str | None = None
+    commands_allowed: Literal[False] = field(default=False, init=False)
+
+
+@dataclass(frozen=True)
+class _Point:
+    at: datetime
+    floor: Fraction
+    ceiling: Fraction
+    phase: str
+
+
+class _InvalidTrajectory(ValueError):
+    def __init__(self, reason_code: str, message: str) -> None:
+        super().__init__(message)
+        self.reason_code = reason_code
+
+
+def _number(value: object, name: str, reason_code: str) -> Fraction:
+    try:
+        if isinstance(value, bool) or not isinstance(value, (int, float)) or not isfinite(value):
+            raise ValueError
+        # Decimal representations preserve exact declared width/rate boundaries;
+        # rational interpolation also avoids overflow between extreme finite edges.
+        return Fraction(str(value))
+    except (TypeError, ValueError, OverflowError) as error:
+        raise _InvalidTrajectory(reason_code, f"{name} must be a finite number, not a boolean or string.") from error
+
+
+def _utc(value: object, name: str) -> datetime:
+    try:
+        if not isinstance(value, datetime) or value.tzinfo is None or value.utcoffset() is None:
+            raise ValueError
+        return value.astimezone(UTC)
+    except (TypeError, ValueError, OverflowError) as error:
+        raise _InvalidTrajectory("invalid_time", f"{name} must be an aware datetime representable in UTC.") from error
+
+
+def _check_band(
+    floor: Fraction,
+    ceiling: Fraction,
+    minimum: Fraction,
+    maximum: Fraction,
+    width: Fraction,
+    *,
+    reason_code: str = "invalid_band",
+) -> None:
+    if not minimum <= floor < ceiling <= maximum or ceiling - floor < width:
+        raise _InvalidTrajectory(reason_code, "Both band edges must fit the approved bounds and minimum width.")
+
+
+def _validate(config: SleepTrajectory) -> tuple[tuple[_Point, ...], Fraction, Fraction, Fraction]:
+    limits = config.limits
+    if not isinstance(limits, TrajectoryLimits):
+        raise _InvalidTrajectory("invalid_configuration", "An enabled, approved routine needs explicit limits.")
+    minimum = _number(limits.minimum_f, "minimum_f", "invalid_limits")
+    maximum = _number(limits.maximum_f, "maximum_f", "invalid_limits")
+    width = _number(limits.minimum_width_f, "minimum_width_f", "invalid_limits")
+    rate = _number(limits.maximum_rate_f_per_hour, "maximum_rate_f_per_hour", "invalid_limits")
+    if minimum >= maximum or not 0 < width <= maximum - minimum or rate <= 0:
+        raise _InvalidTrajectory(
+            "invalid_limits", "Bounds, positive band width and positive edge rate must be feasible."
+        )
+
+    anchors = config.anchors
+    if (
+        not isinstance(anchors, tuple)
+        or len(anchors) != len(_PHASES)
+        or not all(isinstance(anchor, TrajectoryAnchor) for anchor in anchors)
+        or tuple(anchor.phase for anchor in anchors) != _PHASES
+    ):
+        raise _InvalidTrajectory(
+            "invalid_anchors",
+            "Supply an immutable tuple of wind-down, sleeping, waking, return-to-day and daytime anchors.",
+        )
+    points = []
+    for anchor in anchors:
+        at = _utc(anchor.at, f"{anchor.phase} anchor")
+        floor = _number(anchor.floor_f, "floor_f", "invalid_band")
+        ceiling = _number(anchor.ceiling_f, "ceiling_f", "invalid_band")
+        _check_band(floor, ceiling, minimum, maximum, width)
+        points.append(_Point(at, floor, ceiling, anchor.phase))
+
+    for left, right in pairwise(points):
+        elapsed = (right.at - left.at) // _MICROSECOND
+        if elapsed <= 0:
+            raise _InvalidTrajectory(
+                "invalid_anchors", "Anchor instants must be strictly increasing after UTC conversion."
+            )
+        changes = (right.floor - left.floor, right.ceiling - left.ceiling)
+        if (
+            (left.phase == "wind_down" and any(change > 0 for change in changes))
+            or (left.phase == "sleeping" and any(change != 0 for change in changes))
+            or (left.phase == "waking" and any(change < 0 for change in changes))
+        ):
+            raise _InvalidTrajectory(
+                "phase_direction", "Wind-down cannot warm, sleep must hold, and waking cannot cool."
+            )
+        if any(abs(change) * _HOUR_MICROSECONDS > rate * elapsed for change in changes):
+            raise _InvalidTrajectory("rate_exceeded", "A band edge would exceed the approved rate over elapsed time.")
+    return tuple(points), minimum, maximum, width
+
+
+def preview_trajectory(config: SleepTrajectory, *, now: datetime) -> TrajectoryPreview:
+    """Evaluate one approved dated curve without affecting any other component.
+
+    Disabled/unapproved routines expose no band. All anchors are validated before
+    a result is returned, even when the invalid anchor lies after ``now``. Phases
+    are half-open intervals; the final anchor is included, with no extrapolation
+    beyond it. UTC arithmetic distinguishes repeated DST instants but does not
+    resolve ambiguous/nonexistent local schedule times for a caller.
+    """
+    try:
+        if (
+            not isinstance(config, SleepTrajectory)
+            or type(config.enabled) is not bool
+            or type(config.approved) is not bool
+        ):
+            raise _InvalidTrajectory("invalid_configuration", "Supply a SleepTrajectory with explicit boolean flags.")
+        if not config.enabled:
+            return TrajectoryPreview("disabled", "disabled", "Sleep/wake preview is disabled; no band is proposed.")
+        if not config.approved:
+            raise _InvalidTrajectory("unapproved", "The routine has not been approved; no band is proposed.")
+        instant = _utc(now, "Evaluation time")
+        points, minimum, maximum, width = _validate(config)
+        if not points[0].at <= instant <= points[-1].at:
+            raise _InvalidTrajectory(
+                "outside_horizon", "Evaluation is outside the approved dated routine; no extrapolation."
+            )
+
+        current = points[-1]
+        floor, ceiling = current.floor, current.ceiling
+        for left, right in pairwise(points):
+            if left.at <= instant < right.at:
+                fraction = Fraction((instant - left.at) // _MICROSECOND, (right.at - left.at) // _MICROSECOND)
+                floor = left.floor + fraction * (right.floor - left.floor)
+                ceiling = left.ceiling + fraction * (right.ceiling - left.ceiling)
+                current = left
+                break
+
+        floor_f, ceiling_f = float(floor), float(ceiling)
+        # Float presentation must not collapse a very narrow approved band. Withhold
+        # instead of widening it or pretending the rounded representation is valid.
+        _check_band(
+            _number(floor_f, "preview floor", "unrepresentable_preview"),
+            _number(ceiling_f, "preview ceiling", "unrepresentable_preview"),
+            minimum,
+            maximum,
+            width,
+            reason_code="unrepresentable_preview",
+        )
+        return TrajectoryPreview(
+            "preview",
+            "ready",
+            f"Approved {current.phase.replace('_', ' ')} band preview in Fahrenheit; "
+            "not a device target or mode request.",
+            floor_f,
+            ceiling_f,
+            current.phase,
+        )
+    except _InvalidTrajectory as error:
+        return TrajectoryPreview("withheld", error.reason_code, str(error))
